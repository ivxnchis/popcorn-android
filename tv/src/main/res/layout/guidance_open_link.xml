<!-- Like the default guidance, with room for the QR code and address of the page to send links from -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/guidance_container"
        style="?attr/guidanceContainerStyle"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/guidance_breadcrumb"
            style="?attr/guidanceBreadcrumbStyle" />

        <TextView
            android:id="@+id/guidance_title"
            style="?attr/guidanceTitleStyle" />

        <TextView
            android:id="@+id/guidance_description"
            style="?attr/guidanceDescriptionStyle"
            android:layout_marginTop="8dp" />

        <ImageView
            android:id="@+id/guidance_icon"
            android:layout_width="@dimen/open_link_qr_size"
            android:layout_height="@dimen/open_link_qr_size"
            android:layout_marginTop="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/guidance_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFF1F1F1"
            android:textSize="18sp" />

    </LinearLayout>

</FrameLayout>
